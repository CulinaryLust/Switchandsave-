# Zugang zum Admin-Bereich (/admin), HTTP Basic Auth
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern
# Schutz für den täglichen Job (/api/cron/daily?secret=...)
CRON_SECRET=bitte-aendern
# Öffentliche Basis-URL für Links in E-Mails
APP_URL=http://localhost:3000
# CHECK24-Affiliate: Partner-ID und Deeplink-Vorlage aus deinem Partnerkonto
CHECK24_PARTNER_ID=
CHECK24_DEEPLINK_TEMPLATE=https://www.check24.de/{sparte}/vergleich/?zipcode={plz}&totalconsumption={verbrauch}&pid={partnerId}
# PROCHECK24-Webservice: leer lassen = Simulationsmodus
PROCHECK24_API_URL=
PROCHECK24_API_TOKEN=
PROCHECK24_PARTNER_ID=
