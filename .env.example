# Alle Geheimnisse erzeugt "npm run einrichten" automatisch in .env.local.
# Zugang zum Admin-Bereich (/admin): Passwort plus Code aus der Authenticator-App (TOTP)
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern
ADMIN_TOTP_SECRET=
# Signiert die Admin-Sitzung (mind. 32 Zeichen)
SESSION_SECRET=
# Schlüssel für die IBAN-Verschlüsselung (32 Byte, base64). Niemals ändern, sonst sind gespeicherte IBANs unlesbar.
DATA_KEY=
# Rechnung als Foto/PDF auslesen (Claude API). Leer = Funktion aus, Formular wird von Hand ausgefüllt.
ANTHROPIC_API_KEY=
# Schutz für den täglichen Job (/api/cron/daily?secret=...)
CRON_SECRET=bitte-aendern
# Öffentliche Basis-URL für Links in E-Mails
APP_URL=http://localhost:3000
# CHECK24-Affiliate: Partner-ID und Deeplink-Vorlage aus deinem Partnerkonto
CHECK24_PARTNER_ID=
CHECK24_DEEPLINK_TEMPLATE=https://www.check24.de/{sparte}/vergleich/?zipcode={plz}&totalconsumption={verbrauch}&pid={partnerId}
# PROCHECK24-Webservice: leer lassen = Simulationsmodus
PROCHECK24_API_URL=
PROCHECK24_API_TOKEN=
PROCHECK24_PARTNER_ID=
